# =============================================================================
# EJEMPLO DE VARIABLES DE ENTORNO - Asociación Tyto Alba
# =============================================================================
# Copiar este archivo a .env y configurar los valores reales

# ============================================
# BASE DE DATOS - PostgreSQL Compartido
# ============================================
# Usa el PostgreSQL compartido (shared-postgres) mediante la red Docker
# La base de datos y el usuario se crean automáticamente al iniciar shared-postgres

# Nombre de la base de datos
DB_NAME=tytoalba

# Usuario de la base de datos (creado en shared-postgres)
DB_USER=tytoalba_app

# Contraseña del usuario (debe coincidir con la configurada en shared-postgres)
DB_PASSWORD=cambia_esta_contraseña_por_una_segura

# La DATABASE_URL se construye automáticamente en docker-compose.yml:
# DATABASE_URL=postgresql://tytoalba_app:password@shared-postgres:5432/tytoalba?schema=public

# Adaptador de base de datos: 'pg' para producción (PostgreSQL compartido)
DB_ADAPTER=pg

# ============================================
# DESARROLLO LOCAL (opcional)
# ============================================
# Para desarrollo local sin Docker, puedes usar Neon.tech:
# DATABASE_URL="postgresql://usuario:password@host-pooler.neon.tech/db?sslmode=require"
# DB_ADAPTER=neon

# O usar el docker-compose.local.yml que incluye PostgreSQL propio:
# POSTGRES_USER=tytoalba
# POSTGRES_PASSWORD=changeme
# POSTGRES_DB=tytoalba

# ============================================
# SEGURIDAD (REQUERIDO)
# ============================================
# Generar con: openssl rand -hex 32
NUXT_SESSION_PASSWORD=cambiar_esta_clave_por_una_de_32_bytes_hex

# ============================================
# GOOGLE OAUTH (Opcional)
# ============================================
# Obtener credenciales en: https://console.cloud.google.com/apis/credentials
NUXT_OAUTH_GOOGLE_CLIENT_ID=
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=
