# =============================================================================
# EJEMPLO DE VARIABLES DE ENTORNO - Asociación Tyto Alba
# =============================================================================
# Copiar este archivo a .env y configurar los valores reales

# ============================================
# BASE DE DATOS
# ============================================

# --- DESARROLLO (Neon.tech) ---
# Usar la URL de conexión de Neon para desarrollo local
# DATABASE_URL="postgresql://usuario:password@host-pooler.neon.tech/db?sslmode=require"

# --- PRODUCCIÓN (PostgreSQL local en Docker) ---
# En producción, estas variables se usan en docker-compose.yml
POSTGRES_USER=tytoalba
POSTGRES_PASSWORD=cambiar_esta_contraseña_por_una_segura
POSTGRES_DB=tytoalba

# La DATABASE_URL se construye automáticamente en producción:
# DATABASE_URL=postgresql://tytoalba:password@postgres:5432/tytoalba?schema=public

# Adaptador de base de datos: 'neon' para desarrollo, 'pg' para producción
DB_ADAPTER=neon

# ============================================
# SEGURIDAD (REQUERIDO)
# ============================================
# Generar con: openssl rand -hex 32
NUXT_SESSION_PASSWORD=cambiar_esta_clave_por_una_de_32_bytes_hex

# ============================================
# GOOGLE OAUTH (Opcional)
# ============================================
# Obtener credenciales en: https://console.cloud.google.com/apis/credentials
NUXT_OAUTH_GOOGLE_CLIENT_ID=
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=
