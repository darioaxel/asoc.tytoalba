# =============================================================================
# Caddyfile - Asociación Tyto Alba (PRODUCCIÓN)
# =============================================================================

# Redirección de HTTP a HTTPS y www
:80 {
    redir https://www.tytoalba.org{uri}
}

# Dominio principal con www
www.tytoalba.org {
    # Logs
    log {
        output file /var/log/caddy/tytoalba.access.log {
            roll_size 10MB
            roll_keep 10
            roll_keep_for 720h
        }
    }

    # ==================================================================
    # SERVIR UPLOADS DIRECTAMENTE (más eficiente)
    # ==================================================================
    # Nota: Ajusta la ruta según dónde esté montado el volumen en el host
    # Si usas Docker, el volumen está en: /var/lib/docker/volumes/tytoalba_tytoalba_uploads/_data
    route /uploads/* {
        uri strip_prefix /uploads
        root * /var/lib/docker/volumes/tytoalba_tytoalba_uploads/_data
        file_server
        header Cache-Control "public, max-age=86400"
    }

    # Proxy reverso a la app Nuxt (todo lo demás)
    reverse_proxy localhost:3000 {
        header_up Host {host}
        header_up X-Real-IP {remote}
        header_up X-Forwarded-For {remote}
        header_up X-Forwarded-Proto {scheme}
        
        transport http {
            read_timeout 300s
            write_timeout 300s
        }
    }

    # Headers de seguridad
    header {
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
    }

    # Compresión
    encode gzip zstd

    # Caché para assets estáticos de Nuxt
    @static {
        path *.css *.js *.png *.jpg *.jpeg *.gif *.svg *.ico *.woff *.woff2 *.ttf *.eot
    }
    header @static Cache-Control "public, max-age=31536000, immutable"
}

# Redirección del dominio sin www a www
tytoalba.org {
    redir https://www.tytoalba.org{uri}
}
